@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trang chủ Thống kê";
}

<h5 class="mb-3">📊 Báo cáo tổng quan</h5>
<div class="row mb-5">
    <div class="col-md-4 mb-3">
        <div class="card bg-primary text-white h-100 p-3 shadow-sm">
            <h4>Doanh thu</h4>
            <h2>24.500.000đ</h2>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <a href="/Admin/DonHang" class="text-decoration-none">
            <div class="card bg-success text-white h-100 p-3 shadow-sm">
                <h4>Đơn hàng</h4>
                <h2>142 Đơn</h2>
            </div>
        </a>    
    </div>
    <div class="col-md-4 mb-3">
        <div class="card bg-info text-white h-100 p-3 shadow-sm">
            <h4>Món ăn bán chạy</h4>
            <h2>Top 5</h2>
        </div>
    </div>
</div>

<h5 class="mb-3">⚙️ Chức năng quản lý</h5>
<div class="row g-3">
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/PhienGoiMon/Index" class="text-decoration-none">
            <div class="card border border-primary shadow-sm h-100" style="border-radius: 8px; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="card-body">
                    <i class="fas fa-desktop fs-5 mb-3 text-primary"></i>
                    <h6 class="text-primary fw-bold mb-0">Giám sát quán</h6>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/NhanVien" class="text-decoration-none text-dark">
            <div class="card action-card p-4 h-100">
                <i class="fas fa-users"></i>
                <h6 class="mb-0">Nhân viên</h6>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/DonHang" class="text-decoration-none text-dark">
            <div class="card action-card p-4 h-100">
                <i class="fas fa-user-friends"></i>
                <h6 class="mb-0">Khách Hàng</h6>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/ThucDon" class="text-decoration-none text-dark">
            <div class="card action-card p-4 h-100">
                <i class="fas fa-hamburger"></i>
                <h6 class="mb-0">Thực Đơn</h6>
            </div>
        </a>
    </div>   
    
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/BanAn" class="text-decoration-none text-dark">
            <div class="card action-card p-4 h-100">
                <i class="fas fa-chair"></i>
                <h6 class="mb-0">Bàn ăn</h6>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <a href="/Admin/Voucher" class="text-decoration-none text-dark">
            <div class="card action-card p-4 h-100">
                <i class="fas fa-ticket-alt"></i>
                <h6 class="mb-0">Voucher</h6>
            </div>
        </a>
    </div>    
</div>