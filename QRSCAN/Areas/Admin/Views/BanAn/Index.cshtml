@model IEnumerable<QRSCAN.Models.Entities.BanAn>
@{
    ViewData["Title"] = "Quản lý Bàn Ăn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-white text-center rounded p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 text-dark"><i class="fas fa-th-large me-2 text-primary"></i>Sơ đồ Bàn Ăn</h4>
            <button type="button" class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Thêm Bàn
            </button>
        </div>

        <div class="row g-4 text-start">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm rounded-4 border-2 @(item.TrangThai == "Trong" || item.TrangThai == "Trống" ? "border-success" : "border-danger")"
                         style="background-color: @(item.TrangThai == "Trong" || item.TrangThai == "Trống" ? "#f0fdf4" : "#fff1f2"); transition: transform 0.2s;"
                         onmouseover="this.style.transform='translateY(-5px)'"
                         onmouseout="this.style.transform='translateY(0)'">

                        <div class="card-body text-center d-flex flex-column justify-content-center pt-4">
                            <div class="mb-3">
                                <i class="fas fa-square fa-3x @(item.TrangThai == "Trong" || item.TrangThai == "Trống" ? "text-success" : "text-danger")" style="opacity: 0.8;"></i>
                            </div>

                            <h5 class="fw-bold text-dark mt-2 mb-1">@item.TenBan</h5>
                            <p class="text-muted small mb-3">
                                <i class="fas fa-user-friends me-1"></i> @item.SoChoNgoi chỗ ngồi
                            </p>

                            <div>
                                @if (item.TrangThai == "Trong" || item.TrangThai == "Trống")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Trống</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">Đang phục vụ</span>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 d-flex justify-content-center gap-2 pb-3 pt-0">
                            <a href="@item.NoiDungQR" target="_blank" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;" title="Xem QR">
                                <i class="fas fa-qrcode"></i>
                            </a>
                            <button class="btn btn-sm btn-warning text-white rounded-pill px-3 fw-medium shadow-sm" onclick="openEditModal(@item.MaBan)">
                                <i class="fas fa-edit me-1"></i> Sửa
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center text-muted py-5">
                    <i class="fas fa-chair fa-3x mb-3 opacity-50"></i>
                    <p>Chưa có bàn ăn nào. Hãy bấm "Thêm Bàn" để bắt đầu!</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Bàn Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <div class="alert alert-danger" id="createError" style="display:none;"></div>
                <div class="mb-3">
                    <label class="form-label">Tên Bàn (*)</label>
                    <input type="text" class="form-control" id="c_TenBan" placeholder="VD: Bàn 01">
                    <span class="text-danger small fw-medium" id="err-c_TenBan"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Số chỗ ngồi (*)</label>
                    <input type="number" class="form-control" id="c_SoChoNgoi" value="4" min="1">
                    <span class="text-danger small fw-medium" id="err-c_SoChoNgoi"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" id="c_TrangThai">
                        <option value="Trong">Trống</option>
                        <option value="DangPhucVu">Đang phục vụ</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitCreate()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh Sửa Bàn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <div class="alert alert-danger" id="editError" style="display:none;"></div>
                <input type="hidden" id="e_MaBan">
                <div class="mb-3">
                    <label class="form-label">Tên Bàn (*)</label>
                    <input type="text" class="form-control" id="e_TenBan">
                    <span class="text-danger small fw-medium" id="err-e_TenBan"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Số chỗ ngồi (*)</label>
                    <input type="number" class="form-control" id="e_SoChoNgoi" min="1">
                    <span class="text-danger small fw-medium" id="err-e_SoChoNgoi"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" id="e_TrangThai">
                        <option value="Trong">Trống</option>
                        <option value="DangPhucVu">Đang phục vụ</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning text-white" onclick="submitEdit()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSuccessToast(message) {
            var toastHtml = `
            <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055">
                <div class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body fw-bold fs-6">
                            <i class="fas fa-check-circle me-2 align-middle"></i> ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            </div>`;
            $('body').append(toastHtml);
            var toast = new bootstrap.Toast($('.toast').last()[0], { delay: 3500 });
            toast.show();
            $('.toast').last()[0].addEventListener('hidden.bs.toast', function () {
                $(this).closest('.toast-container').remove();
            });
        }

        $(document).ready(function() {
            var msg = sessionStorage.getItem('successMsg');
            if (msg) {
                showSuccessToast(msg);
                sessionStorage.removeItem('successMsg');
            }
        });

        // Xóa viền đỏ và text lỗi
        function clearErrors(prefix) {
            $('.is-invalid').removeClass('is-invalid');
            $('.text-danger.small').text('');
            $('#createError').hide();
            $('#editError').hide();
        }

        // Vẽ viền đỏ và text lỗi
        function handleErrors(errors, prefix) {
            $.each(errors, function (key, value) {
                $('#' + prefix + key).addClass('is-invalid');
                $('#err-' + prefix + key).text(value);
            });
        }

        function openCreateModal() {
            clearErrors('c_');
            $('#c_TenBan').val('');
            $('#c_SoChoNgoi').val(4);
            $('#c_TrangThai').val('Trong');
            $('#createModal').modal('show');
        }

        function submitCreate() {
            clearErrors('c_');
            var data = {
                TenBan: $('#c_TenBan').val(),
                SoChoNgoi: parseInt($('#c_SoChoNgoi').val()),
                TrangThai: $('#c_TrangThai').val()
            };
            $.ajax({
                url: '/Admin/BanAn/Create', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if(res.success) {
                        sessionStorage.setItem('successMsg', 'Đã thêm bàn thành công!');
                        location.reload();
                    } else if(res.errors) {
                        handleErrors(res.errors, 'c_');
                    } else {
                        $('#createError').text(res.message).show();
                    }
                }
            });
        }

        function openEditModal(id) {
            clearErrors('e_');
            $.ajax({
                url: '/Admin/BanAn/GetById?id=' + id, type: 'GET',
                success: function (data) {
                    $('#e_MaBan').val(data.maBan);
                    $('#e_TenBan').val(data.tenBan);
                    $('#e_SoChoNgoi').val(data.soChoNgoi);
                    $('#e_TrangThai').val(data.trangThai);
                    $('#editModal').modal('show');
                }
            });
        }

        function submitEdit() {
            clearErrors('e_');
            var data = {
                MaBan: parseInt($('#e_MaBan').val()),
                TenBan: $('#e_TenBan').val(),
                SoChoNgoi: parseInt($('#e_SoChoNgoi').val()),
                TrangThai: $('#e_TrangThai').val()
            };
            $.ajax({
                url: '/Admin/BanAn/Edit', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if(res.success) {
                        sessionStorage.setItem('successMsg', 'Cập nhật bàn thành công!');
                        location.reload();
                    } else if(res.errors) {
                        handleErrors(res.errors, 'e_');
                    } else {
                        $('#editError').text(res.message).show();
                    }
                }
            });
        }
    </script>
}