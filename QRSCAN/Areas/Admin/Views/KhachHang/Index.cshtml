@model IEnumerable<QRSCAN.Models.Entities.KhachHang>
@{
    ViewData["Title"] = "Quản lý Khách Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-white text-center rounded p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 text-dark">Danh sách Khách Hàng</h4>
            <button class="btn btn-outline-secondary" onclick="location.reload()">
                <i class="fas fa-sync-alt me-2"></i>Làm mới
            </button>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Mã KH</th>
                        <th scope="col">Họ Tên</th>
                        <th scope="col">Số Điện Thoại</th>
                        <th scope="col">Hạng</th>
                        <th scope="col">Điểm</th>
                        <th scope="col">Trạng Thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer;" onclick="openHistoryModal(@item.MaKH, '@item.HoTen')" title="Nhấn để xem lịch sử mua hàng">
                            <td>#@item.MaKH</td>
                            <td class="fw-bold">@item.HoTen</td>
                            <td>@item.SDT</td>
                            <td>
                                @if (item.LoaiKhach == "VIP")
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-crown me-1"></i>VIP</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@item.LoaiKhach</span>
                                }
                            </td>
                            <td class="text-success fw-bold">@item.DiemTichLuy</td>
                            <td>
                                @if (item.TrangThai == "Hoạt động")
                                {
                                    <span class="badge bg-success">@item.TrangThai</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@item.TrangThai</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-warning text-white" onclick="event.stopPropagation(); openEditModal(@item.MaKH)">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-primary fw-bold" id="historyModalTitle">Lịch sử mua hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-secondary" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Thời gian</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-end">Giảm giá</th>
                                <th class="text-end">Đã trả</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="historyBody">
                            <!-- Dữ liệu đổ bằng AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật thông tin Khách Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <input type="hidden" id="editMaKH">

                <div class="mb-3">
                    <label class="form-label">Họ Tên</label>
                    <input type="text" class="form-control" id="editHoTen">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" class="form-control" id="editSDT">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Loại khách (Hạng)</label>
                        <select class="form-select" id="editLoaiKhach">
                            <option value="Thành viên">Thành viên</option>
                            <option value="VIP">VIP</option>
                            <option value="Vãng lai">Vãng lai</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" id="editTrangThai">
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Bị khóa">Bị khóa (Cấm đặt hàng)</option>
                        </select>
                    </div>
                </div>
                <div id="editError" class="text-danger small fw-bold" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning text-white" onclick="submitEdit()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openHistoryModal(maKH, hoTen) {
            $('#historyModalTitle').text('Lịch sử mua hàng - ' + hoTen);
            $('#historyBody').html('<tr><td colspan="6" class="text-center"><div class="spinner-border text-primary spinner-border-sm"></div> Đang tải dữ liệu...</td></tr>');
            $('#historyModal').modal('show');

            $.ajax({
                url: '/Admin/KhachHang/GetLichSuDonHang?maKH=' + maKH,
                type: 'GET',
                success: function (res) {
                    if (res.success) {
                        var html = '';
                        if (res.data.length === 0) {
                            html = '<tr><td colspan="6" class="text-center text-muted py-4">Khách hàng này chưa có đơn hàng nào.</td></tr>';
                        } else {
                            $.each(res.data, function (i, item) {
                                var badgeClass = 'bg-warning text-dark';
                                if(item.trangThai === "HoanThanh" || item.trangThai === "Hoàn thành") badgeClass = "bg-success";
                                if(item.trangThai === "DaHuy" || item.trangThai === "Đã hủy") badgeClass = "bg-danger";

                                html += `<tr>
                                            <td class="fw-bold text-primary">#${item.maDH}</td>
                                            <td>${item.thoiGian}</td>
                                            <td class="text-end">${item.tongTien.toLocaleString('vi-VN')} đ</td>
                                            <td class="text-end text-success">-${item.soTienGiam.toLocaleString('vi-VN')} đ</td>
                                            <td class="text-end text-danger fw-bold">${item.thanhToan.toLocaleString('vi-VN')} đ</td>
                                            <td class="text-center"><span class="badge ${badgeClass}">${item.trangThai}</span></td>
                                         </tr>`;
                            });
                        }
                        $('#historyBody').html(html);
                    } else {
                        $('#historyBody').html('<tr><td colspan="6" class="text-center text-danger">Lỗi tải dữ liệu.</td></tr>');
                    }
                },
                error: function () {
                    $('#historyBody').html('<tr><td colspan="6" class="text-center text-danger">Mất kết nối Server.</td></tr>');
                }
            });
        }
        gi
        function openEditModal(id) {
            $('#editError').hide();
            $.ajax({
                url: '/Admin/KhachHang/GetById?id=' + id,
                type: 'GET',
                success: function (data) {
                    $('#editMaKH').val(data.maKH);
                    $('#editHoTen').val(data.hoTen);
                    $('#editSDT').val(data.sdt);
                    $('#editEmail').val(data.email);
                    $('#editLoaiKhach').val(data.loaiKhach);
                    $('#editTrangThai').val(data.trangThai);

                    $('#editModal').modal('show');
                }
            });
        }

        function submitEdit() {
            var model = {
                MaKH: parseInt($('#editMaKH').val()),
                HoTen: $('#editHoTen').val(),
                SDT: $('#editSDT').val(),
                Email: $('#editEmail').val(),
                LoaiKhach: $('#editLoaiKhach').val(),
                TrangThai: $('#editTrangThai').val()
            };

            $.ajax({
                url: '/Admin/KhachHang/Edit',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if(res.success) {
                        location.reload();
                    } else {
                        $('#editError').text(res.message).show();
                    }
                },
                error: function () {
                    $('#editError').text("Có lỗi xảy ra khi kết nối Server!").show();
                }
            });
        }
    </script>
}