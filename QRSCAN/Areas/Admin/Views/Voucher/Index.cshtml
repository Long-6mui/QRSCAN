@model IEnumerable<QRSCAN.Models.Entities.Voucher>
@{
    ViewData["Title"] = "Quản lý Voucher";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-white text-center rounded p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 text-dark">Danh sách Voucher</h4>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="fas fa-plus me-2"></i>Thêm Voucher
            </button>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Tên Voucher</th>
                        <th scope="col">Loại Giảm</th>
                        <th scope="col">Giá trị</th>
                        <th scope="col">Đơn tối thiểu</th>
                        <th scope="col">Số lượng</th>
                        <th scope="col">Hạn sử dụng</th>
                        <th scope="col">Trạng Thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.MaCode</td>
                            <td>@item.TenVoucher</td>
                            <td>
                                @if (item.LoaiGiamGia == "PhanTram")
                                {
                                    <span>Phần trăm (%)</span>
                                }
                                else
                                {

                                    <span>Tiền mặt</span>
                                }
                            </td>
                            <td class="text-danger fw-bold">
                                @item.GiaTriGiam.ToString("N0") @(item.LoaiGiamGia == "PhanTram" ? "%" : "đ")
                            </td>
                            <td>@item.DieuKien.ToString("N0") đ</td>
                            <td><span class="badge bg-info text-dark">@item.SoLuong</span></td>
                            <td>@item.KetThuc.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "HoatDong")
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm Khóa</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-warning text-white" onclick="openEditModal(@item.MaVoucher)">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm Voucher Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <div class="alert alert-danger" id="createError" style="display:none;"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mã Code (Viết hoa, không dấu)</label>
                        <input type="text" class="form-control" id="c_MaCode" placeholder="VD: GIOVANG10">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tên mô tả Voucher</label>
                        <input type="text" class="form-control" id="c_TenVoucher" placeholder="VD: Giảm 10% giờ vàng">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-danger">Loại giảm giá</label>
                        <select class="form-select" id="c_LoaiGiamGia">
                            <option value="PhanTram">Phần trăm (%)</option>
                            <option value="TienMat">Tiền mặt (VNĐ)</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-danger">Giá trị giảm</label>
                        <input type="number" class="form-control" id="c_GiaTriGiam" value="10">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-primary">Điều kiện (Đơn tối thiểu)</label>
                        <input type="number" class="form-control" id="c_DieuKien" value="100000">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Số lượng</label>
                        <input type="number" class="form-control" id="c_SoLuong" value="100">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" class="form-control" id="c_BatDau">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" class="form-control" id="c_KetThuc">
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" id="c_TrangThai">
                            <option value="HoatDong">Hoạt động</option>
                            <option value="TamKhoa">Tạm khóa</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitCreate()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập Nhật Voucher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <div class="alert alert-danger" id="editError" style="display:none;"></div>
                <input type="hidden" id="e_MaVoucher">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mã Code</label>
                        <input type="text" class="form-control" id="e_MaCode">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tên Voucher</label>
                        <input type="text" class="form-control" id="e_TenVoucher">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-danger">Loại giảm giá</label>
                        <select class="form-select" id="e_LoaiGiamGia">
                            <option value="PhanTram">Phần trăm (%)</option>
                            <option value="TienMat">Tiền mặt (VNĐ)</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-danger">Giá trị giảm</label>
                        <input type="number" class="form-control" id="e_GiaTriGiam">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-primary">Điều kiện (Đơn tối thiểu)</label>
                        <input type="number" class="form-control" id="e_DieuKien">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Số lượng</label>
                        <input type="number" class="form-control" id="e_SoLuong">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" class="form-control" id="e_BatDau">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" class="form-control" id="e_KetThuc">
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" id="e_TrangThai">
                            <option value="HoatDong">Hoạt động</option>
                            <option value="TamKhoa">Tạm khóa</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning text-white" onclick="submitEdit()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var today = new Date();
            var nextMonth = new Date();
            nextMonth.setMonth(today.getMonth() + 1);

            // Format sang dạng yyyy-mm-dd cho ô input
            $('#c_BatDau').val(today.toISOString().split('T')[0]);
            $('#c_KetThuc').val(nextMonth.toISOString().split('T')[0]);
        });

        function submitCreate() {
            var data = {
                MaCode: $('#c_MaCode').val(),
                TenVoucher: $('#c_TenVoucher').val(),
                LoaiGiamGia: $('#c_LoaiGiamGia').val(),
                GiaTriGiam: parseFloat($('#c_GiaTriGiam').val()),
                DieuKien: parseFloat($('#c_DieuKien').val()),
                SoLuong: parseInt($('#c_SoLuong').val()),
                BatDau: $('#c_BatDau').val(),
                KetThuc: $('#c_KetThuc').val(),
                TrangThai: $('#c_TrangThai').val()
            };

            $.ajax({
                url: '/Admin/Voucher/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if(res.success) location.reload();
                    else $('#createError').text(res.message).show();
                }
            });
        }

        function openEditModal(id) {
            $('#editError').hide();
            $.ajax({
                url: '/Admin/Voucher/GetById?id=' + id,
                type: 'GET',
                success: function (d) {
                    $('#e_MaVoucher').val(d.maVoucher);
                    $('#e_MaCode').val(d.maCode);
                    $('#e_TenVoucher').val(d.tenVoucher);
                    $('#e_LoaiGiamGia').val(d.loaiGiamGia);
                    $('#e_GiaTriGiam').val(d.giaTriGiam);
                    $('#e_DieuKien').val(d.dieuKien);
                    $('#e_SoLuong').val(d.soLuong);

                    // Cắt thời gian để bind vào input type="date"
                    $('#e_BatDau').val(d.batDau.split('T')[0]);
                    $('#e_KetThuc').val(d.ketThuc.split('T')[0]);
                    $('#e_TrangThai').val(d.trangThai);

                    $('#editModal').modal('show');
                }
            });
        }

        function submitEdit() {
            var data = {
                MaVoucher: parseInt($('#e_MaVoucher').val()),
                MaCode: $('#e_MaCode').val(),
                TenVoucher: $('#e_TenVoucher').val(),
                LoaiGiamGia: $('#e_LoaiGiamGia').val(),
                GiaTriGiam: parseFloat($('#e_GiaTriGiam').val()),
                DieuKien: parseFloat($('#e_DieuKien').val()),
                SoLuong: parseInt($('#e_SoLuong').val()),
                BatDau: $('#e_BatDau').val(),
                KetThuc: $('#e_KetThuc').val(),
                TrangThai: $('#e_TrangThai').val()
            };

            $.ajax({
                url: '/Admin/Voucher/Edit',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if(res.success) location.reload();
                    else $('#editError').text(res.message).show();
                }
            });
        }
    </script>
}