@model IEnumerable<QRSCAN.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Lịch sử Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="bg-white rounded p-4 shadow-sm mb-4">
        <h5 class="mb-3 text-dark"><i class="fas fa-filter me-2 text-primary"></i>Bộ lọc tìm kiếm</h5>
        <form method="get" action="/Admin/DonHang/Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-muted small">Mã Hóa Đơn</label>
                    <input type="number" class="form-control" name="searchId" placeholder="Nhập ID...">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Từ ngày</label>
                    <input type="date" class="form-control" name="fromDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Đến ngày</label>
                    <input type="date" class="form-control" name="toDate">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-2"></i>Tìm kiếm</button>
                </div>
            </div>
        </form>
    </div>

    <!-- DANH SÁCH ĐƠN HÀNG -->
    <div class="bg-white text-center rounded p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="mb-0 text-dark">Danh sách Đơn Hàng</h4>
            <span class="badge bg-info text-dark p-2 fs-6">Tổng: @ViewBag.TotalRecords đơn</span>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Mã ĐH</th>
                        <th scope="col">Mã KH</th>
                        <th scope="col">Bàn</th>
                        <th scope="col">Thời Gian</th>
                        <th scope="col">Tổng Thanh Toán</th>
                        <th scope="col" class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer;" onclick="openDetailsModal(@item.MaDH)">
                            <td class="fw-bold text-primary">#@item.MaDH</td>

                            <!-- Lấy MaKH và MaBan thông qua PhienGoiMon -->
                            <td>KH-@(item.PhienGoiMon?.MaKH)</td>
                            <td>@(item.PhienGoiMon?.MaBan != null ? "Bàn " + item.PhienGoiMon.MaBan : "Mang đi")</td>

                            <td>@item.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</td>

                            <!-- Tổng thanh toán = Tổng tiền - Tiền giảm -->
                            <td class="fw-bold text-danger">@((item.TongTien - item.SoTienGiam).ToString("N0")) đ</td>

                            <td class="text-center">
                                @if (item.TrangThai == "HoanThanh" || item.TrangThai == "Hoàn thành")
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                }
                                else if (item.TrangThai == "DaHuy" || item.TrangThai == "Đã hủy")
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.TrangThai</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có đơn hàng nào trong thời gian này!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- THANH PHÂN TRANG (PAGINATION) -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center mb-0">

                    <!-- Nút Về Đầu Tiên -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = 1, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })" title="Trang đầu">Đầu</a>
                    </li>

                    <!-- Nút Previous -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">Trước</a>
                    </li>

                    <!-- Hiển thị số trang thông minh -->
                    @{
                        int currentPage = ViewBag.CurrentPage;
                        int totalPages = ViewBag.TotalPages;
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = 1, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">1</a></li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">@i</a>
                            </li>
                        }

                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = totalPages, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">@totalPages</a></li>
                        }
                    }

                    <!-- Nút Next -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">Sau</a>
                    </li>

                    <!-- Nút Về Cuối Cùng -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.TotalPages, searchId = ViewBag.SearchId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })" title="Trang cuối">Cuối</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- MODAL CHI TIẾT ĐƠN HÀNG -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-primary fw-bold" id="modalTitle">Chi tiết Đơn Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-start">
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <p class="text-muted mb-0">Thời gian tạo: <strong id="d_ThoiGian" class="text-dark">...</strong></p>
                    </div>
                    <div class="col-sm-6 text-sm-end">
                        <p class="text-muted mb-0">Trạng thái: <span id="d_TrangThai">...</span></p>
                    </div>
                </div>

                <table class="table table-bordered align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>Món ăn</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody id="chiTietBody"></tbody>
                    <tfoot class="fw-bold bg-light text-end">
                        <tr><td colspan="3">Tổng cộng:</td><td id="d_TongTien">0 đ</td></tr>
                        <tr><td colspan="3" class="text-success">Giảm giá:</td><td class="text-success" id="d_TienGiam">- 0 đ</td></tr>
                        <tr><td colspan="3" class="fs-5">Khách phải trả:</td><td class="fs-5 text-danger" id="d_TongThanhToan">0 đ</td></tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatCurrency(number) {
            return new Intl.NumberFormat('vi-VN').format(number) + ' đ';
        }

        // Mở chi tiết
        function openDetailsModal(id) {
            $('#chiTietBody').html('<tr><td colspan="4" class="text-center"><div class="spinner-border text-primary" role="status"></div> Đang tải...</td></tr>');
            $('#detailsModal').modal('show');

            $.ajax({
                url: '/Admin/DonHang/GetChiTiet?id=' + id,
                type: 'GET',
                success: function (res) {
                    if (res.success) {
                        $('#modalTitle').text('Chi tiết đơn hàng #' + res.maDH);
                        $('#d_ThoiGian').text(res.thoiGian);

                        // Xử lý huy hiệu trạng thái
                        var badgeClass = 'bg-warning text-dark';
                        if(res.trangThai == "HoanThanh" || res.trangThai == "Hoàn thành") badgeClass = "bg-success";
                        if(res.trangThai == "DaHuy" || res.trangThai == "Đã hủy") badgeClass = "bg-danger";
                        $('#d_TrangThai').html('<span class="badge ' + badgeClass + '">' + res.trangThai + '</span>');

                        var html = '';
                        if(res.chiTiets && res.chiTiets.length > 0) {
                            $.each(res.chiTiets, function(i, item) {
                                html += `<tr>
                                            <td>${item.tenMon}</td>
                                            <td class="text-center">${item.soLuong}</td>
                                            <td class="text-end">${formatCurrency(item.donGia)}</td>
                                            <td class="text-end text-primary fw-bold">${formatCurrency(item.thanhTien)}</td>
                                         </tr>`;
                            });
                        } else {
                            html = '<tr><td colspan="4" class="text-center text-muted">Không có dữ liệu món ăn</td></tr>';
                        }

                        $('#chiTietBody').html(html);
                        $('#d_TongTien').text(formatCurrency(res.tongTien));
                        $('#d_TienGiam').text('- ' + formatCurrency(res.tienGiam));
                        $('#d_TongThanhToan').text(formatCurrency(res.tongThanhToan));
                    } else {
                        $('#chiTietBody').html('<tr><td colspan="4" class="text-center text-danger">Lỗi tải dữ liệu!</td></tr>');
                    }
                },
                error: function() {
                    $('#chiTietBody').html('<tr><td colspan="4" class="text-center text-danger">Lỗi kết nối Server!</td></tr>');
                }
            });
        }
    </script>
}