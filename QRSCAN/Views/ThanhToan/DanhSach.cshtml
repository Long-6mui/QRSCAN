@model List<QRSCAN.Models.Entities.ThanhToan>
@{
    ViewData["Title"] = "Thu ngân";
}
@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}
<div class="staff-page">
    <nav class="staff-navbar">
        <div><p>KIMURA RAMEN</p><h2>Thu ngân</h2></div>
        <a asp-controller="NhanVien" asp-action="Index">Quay lại</a>
    </nav>

    <section class="staff-section" style="margin-top:40px;">
        <div class="tab-switch">
            <a class="tab-btn active" asp-action="DanhSach">Thu ngân</a>
            <a class="tab-btn" asp-action="DanhSachHoaDon">Xem hóa đơn</a>
        </div>

        @if (TempData["Error"] != null)
        {
            <p style="color:#b82020;font-weight:700;">@TempData["Error"]</p>
        }

        @if (!Model.Any())
        {
            <p>Không có đơn hàng nào đang chờ thu tiền mặt.</p>
        }
        else
        {
            <div class="table-grid">
                @foreach (var tt in Model)
                {
                    <a class="table-item" asp-action="ThuTien" asp-route-maDonHang="@tt.MaDonHang">
                        Bàn @tt.DonHang?.MaBan
                    </a>
                }
            </div>
        }
    </section>
</div>