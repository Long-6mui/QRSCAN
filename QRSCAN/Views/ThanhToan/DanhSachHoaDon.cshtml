@model List<QRSCAN.Models.Entities.ThanhToan>
@{
    ViewData["Title"] = "Danh sách hóa đơn";
}
@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}
<div class="staff-page">
    <nav class="staff-navbar">
        <div><p>KIMURA RAMEN</p><h2>Danh sách hóa đơn</h2></div>
        <a asp-controller="NhanVien" asp-action="Index">Quay lại</a>
    </nav>

    <section class="staff-section" style="margin-top:40px;">
        @if (!Model.Any())
        {
            <p>Chưa có hóa đơn nào được thanh toán.</p>
        }
        else
        {
            <table class="staff-table">
                <thead><tr><th>Mã đơn</th><th>Bàn</th><th>Tổng thanh toán</th><th>Ngày thanh toán</th><th></th></tr></thead>
                <tbody>
                    @foreach (var tt in Model)
                    {
                        <tr>
                            <td>#@tt.MaDonHang</td>
                            <td>@tt.DonHang?.MaBan</td>
                            <td>@tt.DonHang?.TongThanhToan.ToString("N0")đ</td>
                            <td>@tt.NgayThanhToan.ToString("HH:mm dd/MM/yyyy")</td>
                            <td><a class="staff-btn" asp-action="HoaDon" asp-route-maDonHang="@tt.MaDonHang">Xem</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>