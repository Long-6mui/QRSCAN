@model QRSCAN.Models.Entities.DonHang
@{
    ViewData["Title"] = "Hóa đơn";
    var thanhToan = ViewBag.ThanhToan as QRSCAN.Models.Entities.ThanhToan;
}
@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}
<div class="staff-page">
    <nav class="staff-navbar">
        <div><p>KIMURA RAMEN</p><h2>Hóa đơn #@Model.MaDonHang</h2></div>
        <a asp-action="DanhSachHoaDon">Quay lại</a>
    </nav>

    <section class="staff-section" style="margin-top:40px;">
        <p>Trạng thái thanh toán: <b>@(thanhToan?.TrangThai ?? "Chưa xác định")</b></p>
        <p>Phương thức: <b>@(thanhToan?.PhuongThuc)</b></p>

        <table class="staff-table">
            <thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var ct in Model.ChiTietDonHangs!)
                {
                    <tr>
                        <td>@ct.MonAn?.TenMon</td>
                        <td>@ct.SoLuong</td>
                        <td>@ct.DonGia.ToString("N0")đ</td>
                        <td>@ct.ThanhTien.ToString("N0")đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <p>Tổng tiền món: @Model.TongTien.ToString("N0")đ</p>
        <p>Giảm giá: -@Model.TienGiam.ToString("N0")đ</p>
        <p style="font-size:22px;">Tổng thanh toán: <b>@Model.TongThanhToan.ToString("N0")đ</b></p>
    </section>
</div>