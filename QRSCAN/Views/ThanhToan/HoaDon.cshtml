@model QRSCAN.Models.Entities.HoaDon

@{
    ViewData["Title"] = "Hóa đơn";

    var donHang = Model.DonHang;
    var tongThanhToan = Model.TongTien - Model.SoTienGiam;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}

<div class="staff-page">
    <nav class="staff-navbar">
        <div>
            <p>KIMURA RAMEN</p>
            <h2>Hóa đơn - @(donHang?.PhienGoiMon?.BanAn?.TenBan ?? "Không rõ bàn")</h2>
        </div>

        <a asp-controller="ThanhToan" asp-action="DanhSachHoaDon">Quay lại</a>
    </nav>

    <section class="staff-section" style="margin-top:40px;">
        <div class="staff-invoice-card">
            <p>Trạng thái thanh toán: <b>@Model.TrangThai</b></p>
            <p>Phương thức: <b>@Model.PhuongThucThanhToan?.TenPT</b></p>
            <p>Nhân viên xử lý: <b>@(Model.NhanVien?.HoTen ?? "Chưa có")</b></p>
            <p>Thời gian thanh toán: <b>@Model.ThoiGianTao.ToString("HH:mm 'ngày' dd/MM/yyyy")</b></p>

            <table class="staff-table">
                <thead>
                    <tr>
                        <th>Món</th>
                        <th>SL</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>

                <tbody>
                    @if (donHang?.ChiTietDonHangs != null)
                    {
                        foreach (var ct in donHang.ChiTietDonHangs)
                        {
                            <tr>
                                <td>@ct.MonAn?.TenMon</td>
                                <td>@ct.SoLuong</td>
                                <td>@ct.DonGia.ToString("N0")đ</td>
                                <td>@ct.ThanhTien.ToString("N0")đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <p>Tổng tiền món: @Model.TongTien.ToString("N0")đ</p>
            <p>Giảm giá: -@Model.SoTienGiam.ToString("N0")đ</p>

            <p class="staff-invoice-total">
                Tổng thanh toán: <b>@tongThanhToan.ToString("N0")đ</b>
            </p>
        </div>
    </section>
</div>