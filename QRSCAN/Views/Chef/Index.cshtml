@model List<QRSCAN.Models.Entities.DonHang>

@{
    ViewData["Title"] = "Màn hình nhà bếp";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}

<div class="staff-page">
    <nav class="staff-navbar">
        <div>
            <p>KIMURA RAMEN</p>
            <h2>Khu vực bếp</h2>
        </div>

        <a asp-controller="Account" asp-action="Logout">Đăng xuất</a>
    </nav>

    <section class="staff-section" style="margin-top:40px;">
        <h1>Màn hình nhà bếp</h1>
        <p>Quản lý và theo dõi trạng thái chế biến món ăn</p>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                <h2>Không có đơn hàng nào</h2>
                <p>Hiện tại nhà bếp chưa có món mới hoặc đơn đang cần xử lý.</p>
            </div>
        }
        else
        {
            <div class="chef-order-list">
                @foreach (var don in Model)
                {
                    <div class="chef-order-card">
                        <div class="chef-order-header">
                            <div>
                                <h2>Đơn #@don.MaDH</h2>
                                <p>@(don.PhienGoiMon?.BanAn?.TenBan ?? "Không rõ bàn")</p>
                                <p>@don.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            <span class="order-status">@don.TrangThai</span>
                        </div>

                        <table class="staff-table">
                            <thead>
                                <tr>
                                    <th>Món</th>
                                    <th>Số lượng</th>
                                    <th>Ghi chú</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var ct in don.ChiTietDonHangs)
                                {
                                    <tr>
                                        <td>@ct.MonAn?.TenMon</td>
                                        <td>@ct.SoLuong</td>
                                        <td>@(ct.GhiChu ?? "")</td>
                                        <td>@ct.TrangThai</td>
                                        <td>
                                            @if (ct.TrangThai != "HoanThanh")
                                            {
                                                <form asp-controller="Chef" asp-action="HoanThanhMon" method="post">
                                                    <input type="hidden" name="maCT_DH" value="@ct.MaCT_DH" />
                                                    <button type="submit" class="staff-btn">Hoàn thành món</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span>Đã xong</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div style="margin-top:16px;">
                            @if (don.TrangThai == "ChoXacNhan")
                            {
                                <form asp-controller="Chef" asp-action="NhanDon" method="post" style="display:inline-block;">
                                    <input type="hidden" name="maDH" value="@don.MaDH" />
                                    <button type="submit" class="staff-btn">Nhận đơn</button>
                                </form>
                            }

                            <form asp-controller="Chef" asp-action="HoanThanhDon" method="post" style="display:inline-block;">
                                <input type="hidden" name="maDH" value="@don.MaDH" />
                                <button type="submit" class="staff-btn">Hoàn thành đơn</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>