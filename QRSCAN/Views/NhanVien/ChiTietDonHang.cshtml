@model QRSCAN.Models.Entities.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var ban = Model.PhienGoiMon?.BanAn;
    var hoaDon = Model.HoaDons?.FirstOrDefault();

    var tongThanhToan = Model.TongTien - Model.SoTienGiam;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nhanvien.css" asp-append-version="true" />
}

<div class="staff-page">
    <div class="nv-page">
        <nav class="staff-navbar">
            <div>
                <p>KIMURA RAMEN</p>
                <h2>Chi tiết đơn hàng</h2>
            </div>

            <div class="nv-top-actions">
                <a asp-controller="NhanVien" asp-action="Index" class="nv-top-btn secondary">
                    Quay lại
                </a>

                <a asp-controller="Account" asp-action="Logout" class="nv-top-btn logout">
                    Đăng xuất
                </a>
            </div>
        </nav>

        <section class="nv-detail-layout">
            <div class="nv-detail-main">
                <div class="nv-detail-card">
                    <div class="nv-detail-head">
                        <div>
                            <p>ORDER DETAIL</p>
                            <h1>@(ban?.TenBan ?? "Không rõ bàn")</h1>
                            <span>
                                Trạng thái:
                                <strong>@Model.TrangThai</strong>
                            </span>
                        </div>

                        <span class="nv-mini-status payment">
                            @Model.TrangThai
                        </span>
                    </div>

                    <div class="nv-detail-meta">
                        <div>
                            <span>Mã đơn</span>
                            <strong>#@Model.MaDH</strong>
                        </div>

                        <div>
                            <span>Thời gian tạo</span>
                            <strong>@Model.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>

                        <div>
                            <span>Trạng thái đơn</span>
                            <strong>@Model.TrangThai</strong>
                        </div>
                    </div>

                    @if (Model.ChiTietDonHangs == null || !Model.ChiTietDonHangs.Any())
                    {
                        <div class="nv-empty-box">
                            <h3>Chưa có món</h3>
                            <p>Đơn hàng này chưa có chi tiết món ăn.</p>
                        </div>
                    }
                    else
                    {
                        <div class="nv-table-wrap">
                            <table class="nv-table">
                                <thead>
                                    <tr>
                                        <th>Món</th>
                                        <th>Số lượng</th>
                                        <th>Đơn giá</th>
                                        <th>Thành tiền</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var ct in Model.ChiTietDonHangs)
                                    {
                                        <tr>
                                            <td>@ct.MonAn?.TenMon</td>
                                            <td>@ct.SoLuong</td>
                                            <td>@ct.DonGia.ToString("N0")đ</td>
                                            <td>@ct.ThanhTien.ToString("N0")đ</td>
                                            <td>@ct.TrangThai</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <aside class="nv-detail-side">
                <div class="nv-detail-card">
                    <div class="nv-panel-title">
                        <div>
                            <p>SUMMARY</p>
                            <h2>Thông tin đơn</h2>
                        </div>
                    </div>

                    <div class="nv-summary">
                        <div class="nv-summary-row">
                            <span>Mã bàn</span>
                            <strong>#@(ban?.MaBan)</strong>
                        </div>

                        <div class="nv-summary-row">
                            <span>Số chỗ ngồi</span>
                            <strong>@(ban?.SoChoNgoi ?? 0)</strong>
                        </div>

                        <div class="nv-summary-row">
                            <span>Trạng thái</span>
                            <strong>@Model.TrangThai</strong>
                        </div>

                        <div class="nv-summary-row">
                            <span>Tạm tính</span>
                            <strong>@Model.TongTien.ToString("N0")đ</strong>
                        </div>

                        <div class="nv-summary-row">
                            <span>Giảm giá</span>
                            <strong>-@Model.SoTienGiam.ToString("N0")đ</strong>
                        </div>

                        <div class="nv-summary-row total">
                            <span>Cần thu</span>
                            <strong>@tongThanhToan.ToString("N0")đ</strong>
                        </div>

                        @if (hoaDon != null)
                        {
                            <div class="nv-summary-row">
                                <span>Trạng thái hóa đơn</span>
                                <strong>@hoaDon.TrangThai</strong>
                            </div>

                            <div class="nv-summary-row">
                                <span>Phương thức TT</span>
                                <strong>@(hoaDon.PhuongThucThanhToan?.TenPT ?? "Chưa chọn")</strong>
                            </div>
                        }
                    </div>

                    <div class="nv-detail-actions">
                        @if (Model.TrangThai == "HoanThanh" && hoaDon != null && hoaDon.TrangThai == "ChuaThanhToan")
                        {
                            <a asp-controller="ThanhToan"
                               asp-action="ThuTien"
                               asp-route-maDH="@Model.MaDH"
                               class="nv-action-btn">
                                Qua thanh toán
                            </a>
                        }
                    </div>
                </div>
            </aside>
        </section>
    </div>
</div>