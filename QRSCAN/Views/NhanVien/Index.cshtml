@model QRSCAN.ViewModels.NhanVienDashboardViewModel

@{
    ViewData["Title"] = "Nhân viên quầy";
    var hoTenNV = Context.Session.GetString("HoTenNV") ?? "Nhân viên quầy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nhanvien.css" asp-append-version="true" />
}

<div class="staff-page">
    <div class="nv-page">
        <nav class="staff-navbar">
            <div>
                <p>KIMURA RAMEN</p>
                <h2>Nhân viên quầy</h2>
            </div>

            <div class="nv-top-actions">
                <a asp-controller="ThanhToan" asp-action="DanhSach" class="nv-top-btn">
                    Thanh toán hóa đơn
                </a>

                <a asp-controller="ThanhToan" asp-action="DanhSachHoaDon" class="nv-top-btn secondary">
                    Xem hóa đơn
                </a>

                <a asp-controller="Account" asp-action="Logout" class="nv-top-btn logout">
                    Đăng xuất
                </a>
            </div>
        </nav>


        <main class="nv-dashboard">
            <section class="nv-left-panel">
                <div class="nv-panel-title">
                    <div>
                        <p>ORDER</p>
                        <h2>Đơn hàng cần xử lý</h2>
                    </div>

                    <span>@Model.DonHangsCanXuLy.Count đơn</span>
                </div>

                @if (Model.DonHangsCanXuLy == null || !Model.DonHangsCanXuLy.Any())
                {
                    <div class="nv-empty-box">
                        <h3>Chưa có đơn cần xử lý</h3>
                        <p>Khi khách gửi đơn, đơn sẽ hiển thị tại đây.</p>
                    </div>
                }
                else
                {
                    <div class="nv-order-list-compact">
                        @foreach (var don in Model.DonHangsCanXuLy)
                        {
                            var tongThanhToan = don.TongTien - don.SoTienGiam;

                            var statusText = don.TrangThai switch
                            {
                                "ChoXacNhan" => "Chờ xác nhận",
                                "DangCheBien" => "Đang chế biến",
                                "DaPhucVu" => "Chờ phục vụ",
                                "HoanThanh" => "Chờ thanh toán",
                                _ => don.TrangThai
                            };

                            var statusClass = don.TrangThai switch
                            {
                                "ChoXacNhan" => "waiting",
                                "DangCheBien" => "cooking",
                                "DaPhucVu" => "served",
                                "HoanThanh" => "payment",
                                _ => ""
                            };

                            <a class="nv-order-box"
                               asp-controller="NhanVien"
                               asp-action="ChiTietDonHang"
                               asp-route-maDH="@don.MaDH">
                                <div class="nv-order-box-top">
                                    <div>
                                        <h3>Đơn #@don.MaDH</h3>
                                        <p>@(don.PhienGoiMon?.BanAn?.TenBan ?? "Không rõ bàn")</p>
                                    </div>

                                    <span class="nv-mini-status @statusClass">
                                        @statusText
                                    </span>
                                </div>

                                <div class="nv-order-box-info">
                                    <span>@don.ThoiGianTao.ToString("HH:mm dd/MM")</span>
                                    <strong>@tongThanhToan.ToString("N0")đ</strong>
                                </div>
                            </a>
                        }
                    </div>
                }
            </section>

            <section class="nv-right-panel">
                <div class="nv-panel-title">
                    <div>
                        <p>TABLE</p>
                        <h2>Sơ đồ bàn</h2>
                    </div>

                    <span>@Model.BanAns.Count bàn</span>
                </div>

                <div class="nv-table-legend">
                    <span><i class="legend-dot empty"></i>Trống</span>
                    <span><i class="legend-dot serving"></i>Đang phục vụ</span>
                    <span><i class="legend-dot payment"></i>Chờ thanh toán</span>
                </div>

                @if (Model.BanAns == null || !Model.BanAns.Any())
                {
                    <div class="nv-empty-box">
                        <h3>Chưa có dữ liệu bàn</h3>
                        <p>Vui lòng kiểm tra bảng BanAn trong cơ sở dữ liệu.</p>
                    </div>
                }
                else
                {
                    <div class="nv-table-grid">
                        @foreach (var ban in Model.BanAns)
                        {
                            var banText = ban.TrangThai switch
                            {
                                "Trong" => "Trống",
                                "DangPhucVu" => "Đang phục vụ",
                                "ChoThanhToan" => "Chờ thanh toán",
                                _ => ban.TrangThai
                            };

                            var banClass = ban.TrangThai switch
                            {
                                "Trong" => "empty",
                                "DangPhucVu" => "serving",
                                "ChoThanhToan" => "payment",
                                _ => "empty"
                            };

                            <a class="nv-table-card @banClass"
                               asp-controller="NhanVien"
                               asp-action="ChiTietBan"
                               asp-route-maBan="@ban.MaBan">
                                <div>
                                    <h3>@ban.TenBan</h3>
                                    <p>@banText</p>
                                </div>

                                @if (ban.TongTien != null)
                                {
                                    <strong>@ban.TongTien.Value.ToString("N0")đ</strong>
                                }
                                else
                                {
                                    <strong>—</strong>
                                }
                            </a>
                        }
                    </div>
                }
            </section>
        </main>
    </div>
</div>