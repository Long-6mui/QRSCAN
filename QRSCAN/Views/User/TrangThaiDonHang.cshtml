@model List<QRSCAN.Models.Entities.DonHang>

@{
    ViewData["Title"] = "Trạng thái đơn hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
}

<div class="user-page">
    <div class="user-header">
        <div>
            <p>KIMURA RAMEN</p>
            <h1>Trạng thái đơn hàng</h1>
            <span>Theo dõi tiến trình xử lý món ăn của bạn.</span>
        </div>

        <a asp-controller="Home" asp-action="Index">← Về trang chủ</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">
            <h2>Không có đơn đang xử lý</h2>
            <p>Hiện tại bạn chưa có đơn hàng nào đang được xử lý.</p>
        </div>
    }
    else
    {
        <div class="tracking-list">
            @foreach (var don in Model)
            {
                var tongThanhToan = don.TongTien - don.SoTienGiam;

                <div class="tracking-card-v2">
                    <div class="tracking-header">
                        <div>
                            <h2>Đơn #@don.MaDH</h2>
                            <p>@(don.PhienGoiMon?.BanAn?.TenBan ?? "Không rõ bàn")</p>
                            <span>@don.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <strong>@don.TrangThai</strong>
                    </div>

                    <div class="tracking-body">
                        <p>Tổng thanh toán: <b>@tongThanhToan.ToString("N0")đ</b></p>

                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th>Món</th>
                                    <th>SL</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var ct in don.ChiTietDonHangs)
                                {
                                    <tr>
                                        <td>@ct.MonAn?.TenMon</td>
                                        <td>@ct.SoLuong</td>
                                        <td>@ct.TrangThai</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="User"
                       asp-action="ChiTietDonHang"
                       asp-route-maDH="@don.MaDH"
                       class="user-action-btn">
                        Xem chi tiết
                    </a>
                </div>
            }
        </div>
    }
</div>