@model List<QRSCAN.Models.Entities.DonHang>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
}

<div class="user-page">
    <div class="user-header">
        <div>
            <p>KIMURA RAMEN</p>
            <h1>Lịch sử đơn hàng</h1>
            <span>Theo dõi các đơn hàng bạn đã đặt tại nhà hàng.</span>
        </div>

        <a asp-controller="Home" asp-action="Index">← Về trang chủ</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">
            <h2>Chưa có đơn hàng nào</h2>
            <p>Bạn chưa đặt đơn gọi món nào.</p>
        </div>
    }
    else
    {
        <div class="order-history-list">
            @foreach (var item in Model)
            {
                var tongThanhToan = item.TongTien - item.SoTienGiam;

                <div class="order-history-card">
                    <div class="order-history-top">
                        <div>
                            <h2>Đơn hàng #@item.MaDH</h2>
                            <p>
                                @(item.PhienGoiMon?.BanAn?.TenBan ?? "Không rõ bàn")
                                -
                                @item.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <span class="order-status">@item.TrangThai</span>
                    </div>

                    <div class="order-history-info">
                        <p>Tổng tiền món: <strong>@item.TongTien.ToString("N0")đ</strong></p>
                        <p>Giảm giá: <strong>-@item.SoTienGiam.ToString("N0")đ</strong></p>
                        <p>Thanh toán: <strong>@tongThanhToan.ToString("N0")đ</strong></p>
                    </div>

                    <a asp-controller="User"
                       asp-action="ChiTietDonHang"
                       asp-route-maDH="@item.MaDH"
                       class="user-action-btn">
                        Xem chi tiết
                    </a>
                </div>
            }
        </div>
    }
</div>